# Copiar a .env y completar localmente. Nunca subir .env a Git.
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

MAILER_SERVICE=gmail
MAILER_USER=
MAILER_TOKEN=
# Opcional; si se omite, se utiliza MAILER_USER.
REPORTS_NOTIFICATION_EMAIL=

AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Identidad con permiso s3:PutObject limitado a reports/*.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales; omitir con credenciales permanentes.
AWS_SESSION_TOKEN=

DOCKER_USER=
